---
import BaseLayout from '@/layouts/BaseLayout.astro';
import KnowledgeGraph from '@/components/KnowledgeGraph.astro';
import { getKnowledgeNodes } from '@/lib/knowledge';
const nodes = getKnowledgeNodes();
const companies = nodes.filter((n) => n.type === 'company');
const technologies = nodes.filter((n) => n.type === 'technology');
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="hero">
    <div class="eyebrow">A VISUAL INDUSTRY KNOWLEDGE SYSTEM</div>
    <h1>Explore how industries<br/><em>actually connect.</em></h1>
    <p class="lede">從技術、公司、產品、應用到事件與證據，把散落的研究變成可探索的產業地圖。Markdown 是知識本體，網站只是它的視覺投影。</p>
    <div class="hero-actions">
      <a class="button primary" href="#graph">Explore the graph</a>
      <a class="button" href={`${base}entity/ddr3`}>Start with DDR3</a>
    </div>
  </section>

  <section class="stats-strip">
    <div><strong>{nodes.length}</strong><span>Knowledge nodes</span></div>
    <div><strong>{companies.length}</strong><span>Companies</span></div>
    <div><strong>{technologies.length}</strong><span>Technologies</span></div>
    <div><strong>1</strong><span>Industry lens</span></div>
  </section>

  <section id="industries" class="section">
    <div class="section-heading">
      <div><span class="eyebrow">INDUSTRY LENSES</span><h2>Start from an industry.</h2></div>
      <p>同一個 entity 可以同時出現在不同產業；Industry 只是觀看世界的一種 lens。</p>
    </div>
    <a class="industry-card" href={`${base}entity/memory`}>
      <div>
        <span class="pill">LIVE · FIRST VERTICAL</span>
        <h3>Memory</h3>
        <p>DRAM · Specialty Memory · Legacy nodes · Supply transitions · Applications</p>
      </div>
      <div class="industry-focus">
        <small>Current focus</small>
        <strong>DDR3</strong>
        <span>→</span>
      </div>
    </a>
  </section>

  <section id="graph" class="section graph-section">
    <div class="section-heading">
      <div><span class="eyebrow">KNOWLEDGE GRAPH</span><h2>Follow the relationships.</h2></div>
      <p>每個 Markdown wikilink 都會成為一條可探索的關係。新增內容時，圖譜自然長大。</p>
    </div>
    <KnowledgeGraph />
  </section>

  <section class="section">
    <div class="section-heading">
      <div><span class="eyebrow">SEED ENTITIES</span><h2>Memory, decomposed.</h2></div>
    </div>
    <div class="entity-grid">
      {nodes.filter((n) => n.type !== 'industry').map((node) => (
        <a class="entity-card" href={`${base}entity/${node.id}`}>
          <span class={`type type-${node.type}`}>{node.type}</span>
          <h3>{node.title}</h3>
          <p>{node.summary ?? 'Explore this node in the industry graph.'}</p>
          <div class="tags">{node.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
