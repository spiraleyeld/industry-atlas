---
import { getKnowledgeGraph } from '@/lib/knowledge';
const graph = getKnowledgeGraph();
const base = import.meta.env.BASE_URL;
---

<div class="graph-shell" data-base={base}>
  <div class="graph-toolbar">
    <span>Interactive knowledge graph</span>
    <span class="muted">drag · zoom · click</span>
  </div>
  <svg id="knowledge-graph" viewBox="0 0 1100 650" aria-label="Industry knowledge graph"></svg>
</div>

<script id="graph-data" type="application/json" set:html={JSON.stringify(graph)}></script>

<script>
  import * as d3 from 'd3';

  const dataEl = document.querySelector('#graph-data');
  const svgEl = document.querySelector('#knowledge-graph');
  const shell = document.querySelector('.graph-shell');
  const base = shell?.getAttribute('data-base') || '/';
  if (dataEl && svgEl) {
    const graph = JSON.parse(dataEl.textContent || '{"nodes":[],"edges":[]}');
    const svg = d3.select(svgEl);
    const width = 1100;
    const height = 650;
    const root = svg.append('g');

    svg.call(
      d3.zoom<SVGSVGElement, unknown>().scaleExtent([0.35, 4]).on('zoom', (event) => {
        root.attr('transform', event.transform);
      })
    );

    const colorByType: Record<string, string> = {
      industry: '#a78bfa',
      company: '#60a5fa',
      technology: '#34d399',
      application: '#fbbf24',
      event: '#fb7185',
      thesis: '#f472b6',
      evidence: '#94a3b8',
    };

    const links = graph.edges.map((d: any) => ({ ...d }));
    const nodes = graph.nodes.map((d: any) => ({ ...d }));

    const link = root.append('g')
      .attr('stroke', '#334155')
      .attr('stroke-opacity', 0.65)
      .selectAll('line')
      .data(links)
      .join('line')
      .attr('stroke-width', 1.2);

    const node = root.append('g')
      .selectAll('g')
      .data(nodes)
      .join('g')
      .style('cursor', 'pointer')
      .on('click', (_, d: any) => {
        window.location.href = `${base}entity/${encodeURIComponent(d.id)}`;
      });

    node.append('circle')
      .attr('r', (d: any) => d.type === 'industry' ? 16 : d.type === 'company' ? 12 : 9)
      .attr('fill', (d: any) => colorByType[d.type] || '#cbd5e1')
      .attr('stroke', '#0f172a')
      .attr('stroke-width', 2);

    node.append('text')
      .text((d: any) => d.title)
      .attr('x', 14)
      .attr('y', 4)
      .attr('fill', '#e2e8f0')
      .attr('font-size', 12)
      .attr('paint-order', 'stroke')
      .attr('stroke', '#0f172a')
      .attr('stroke-width', 4)
      .attr('stroke-linejoin', 'round');

    const simulation = d3.forceSimulation(nodes)
      .force('link', d3.forceLink(links).id((d: any) => d.id).distance(105).strength(0.65))
      .force('charge', d3.forceManyBody().strength(-380))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .force('collision', d3.forceCollide().radius(32));

    node.call(
      d3.drag<any, any>()
        .on('start', (event, d) => {
          if (!event.active) simulation.alphaTarget(0.3).restart();
          d.fx = d.x;
          d.fy = d.y;
        })
        .on('drag', (event, d) => {
          d.fx = event.x;
          d.fy = event.y;
        })
        .on('end', (event, d) => {
          if (!event.active) simulation.alphaTarget(0);
          d.fx = null;
          d.fy = null;
        })
    );

    simulation.on('tick', () => {
      link
        .attr('x1', (d: any) => d.source.x)
        .attr('y1', (d: any) => d.source.y)
        .attr('x2', (d: any) => d.target.x)
        .attr('y2', (d: any) => d.target.y);
      node.attr('transform', (d: any) => `translate(${d.x},${d.y})`);
    });
  }
</script>
